# Shared image with infomator. On a shared host, pin a tag or digest in .env
# after a sandbox image change. Do not rely on :latest moving under you.
# Example: infomator/infomator-sandbox:2026-11-10
SANDBOX_IMAGE=infomator/infomator-sandbox:latest
SANDBOX_NAME_PREFIX=yuan-sandbox
SANDBOX_API_PORT=8081
# Container-internal timeout (minutes). Not the same env as ABSOLUTE_MAX (seconds),
# but should cover the API ceiling: ABSOLUTE_MAX_LIFETIME_SECONDS / 60 (= 1440 for 24h).
# Creating a sandbox also uses max(this, ceil(ABSOLUTE_MAX/60)) so a too-small value is raised.
SANDBOX_TTL_MINUTES=1440
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPU_QUOTA=50000
# Do not inherit the host json-file rotation (infomator compose uses max-size 10m).
# That rotation drops the container before the 30 min window and mixes log bytes.
SANDBOX_LOG_DRIVER=local
SANDBOX_LOG_MAX_SIZE=20m
SANDBOX_LOG_MAX_FILE=3
# Destroy this many seconds after an explicit script-finished event.
IDLE_GRACE_SECONDS=30
# Initial destroy_after after create (also used if no heartbeats).
MAX_LIFETIME_SECONDS=1800
# Each POST .../heartbeat resets the recycle countdown to this many seconds (30 min).
HEARTBEAT_EXTEND_SECONDS=1800
# Absolute ceiling from created_at; heartbeat cannot push past this (24 h).
# Keep SANDBOX_TTL_MINUTES >= this / 60.
ABSOLUTE_MAX_LIFETIME_SECONDS=86400
# Behind nginx, bind loopback only so :8090 is not public.
# For local smoke tests without a proxy, use 0.0.0.0.
HOST=127.0.0.1
PORT=8090
